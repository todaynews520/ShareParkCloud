/* 全局基础 */
page {
  background: #f7f8fa;
  height: 100vh;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  box-sizing: border-box;
}

.page-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  width: 100%;
  padding-bottom: calc(88rpx + env(safe-area-inset-bottom));
}

/* 顶部导航 */
.page-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 50rpx 24rpx 40rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.nav-back {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #fff;
  transition: transform 0.2s;
}

.nav-back:active {
  transform: translateX(-4rpx);
}

.nav-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.nav-placeholder {
  width: 48rpx;
}

/* 筛选栏 */
.filter-bar {
  background: #fff;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.filter-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  border: 2rpx solid #eee;
}

.filter-icon {
  font-size: 28rpx;
}

.filter-text {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.filter-arrow {
  font-size: 20rpx;
  color: #999;
}

.filter-stats {
  display: flex;
  gap: 24rpx;
}

.stat-text {
  font-size: 24rpx;
  color: #667eea;
  font-weight: 600;
}

/* 筛选弹窗 */
.filter-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.filter-modal-content {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.filter-modal-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  position: relative;
}

.modal-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.modal-close {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.filter-modal-body {
  padding: 32rpx;
}

.filter-modal-footer {
  display: flex;
  padding: 0 32rpx 32rpx;
  gap: 16rpx;
}

.filter-btn {
  flex: 1;
  height: 88rpx;
  border: none;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0;
}

.filter-btn::after {
  border: none;
}

.filter-btn.cancel {
  background: #f5f5f5;
  color: #333;
}

.filter-btn.confirm {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

/* 列表容器 */
.list-container {
  flex: 1;
  padding: 16rpx 24rpx;
  overflow-y: auto;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 16rpx;
  color: #999;
}

.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(102, 126, 234, 0.1);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 24rpx;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 预约列表 */
.reservation-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.reservation-item {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.08) 0%, rgba(118, 75, 162, 0.08) 100%);
}

.spot-number {
  font-size: 32rpx;
  color: #667eea;
  font-weight: 700;
}

.status-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-tag.confirmed {
  background: #d4edda;
  color: #155724;
}

.status-tag.cancelled {
  background: #f5f5f5;
  color: #999;
}

.item-body {
  padding: 24rpx;
}

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.item-row:last-child {
  border-bottom: none;
}

.row-label {
  font-size: 24rpx;
  color: #999;
}

.row-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.item-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
  background: #fafbfc;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  background: #fff;
  color: #667eea;
  border: 2rpx solid #667eea;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  padding: 0;
}

.action-btn::after {
  border: none;
}

.action-btn.cancel {
  color: #f5222d;
  border-color: #f5222d;
}

.action-btn:active:not([disabled]) {
  opacity: 0.8;
}

/* 登录提示 */
.login-prompt {
  padding: 40rpx 24rpx;
  display: flex;
  justify-content: center;
}

.login-btn {
  padding: 24rpx 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.login-btn::after {
  border: none;
}
