/* pages/success/index.wxss */
@import "../../styles/theme.wxss";

.success-page {
  min-height: 100vh;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

/* 成功图标 */
.success-icon {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, var(--color-success) 0%, #22c55e 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  animation: scaleIn 0.5s ease-out;
}

@keyframes scaleIn {
  from {
    transform: scale(0);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.icon {
  font-size: 96rpx;
  color: #fff;
  font-weight: 300;
}

/* 成功文本 */
.success-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* 倒计时提示 */
.countdown-hint {
  padding: 20rpx 32rpx;
  background: var(--color-primary-light);
  border-radius: 24rpx;
  margin-bottom: 60rpx;
}

.countdown-hint text {
  font-size: 26rpx;
  color: var(--color-primary);
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  width: 100%;
}

.btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.btn.primary {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
  color: #fff;
}

.btn:not(.primary) {
  background: #fff;
  color: var(--color-text-primary);
}

.btn::after {
  border: none;
}
