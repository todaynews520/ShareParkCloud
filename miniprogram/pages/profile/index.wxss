/* pages/profile/index.wxss */
@import "../../styles/theme.wxss";

.profile-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 40rpx;
}

/* 用户信息区域 */
.user-section {
  padding: 48rpx 24rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-bottom: 16rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.user-tags {
  display: flex;
  gap: 12rpx;
}

.user-tag {
  padding: 6rpx 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  font-size: 22rpx;
}

.guest-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.guest-text {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 24rpx;
}

.login-btn {
  width: 200rpx;
  height: 64rpx;
  background: #fff;
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 32rpx;
  border: none;
}

.login-btn::after {
  border: none;
}

/* 统计数据 */
.stats-section {
  display: flex;
  justify-content: space-around;
  padding: 32rpx 24rpx;
  background: #fff;
  margin: -24rpx 24rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: var(--shadow-md);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.stat-divider {
  width: 1rpx;
  background: var(--color-border);
}

/* 内容区域 */
.content-section {
  padding: 0 24rpx;
}

/* Tab切换 */
.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  transition: all 0.2s;
}

.tab-item.active {
  background: var(--color-primary);
  color: #fff;
}

.tab-count {
  font-size: 22rpx;
  opacity: 0.8;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* 列表项 */
.list-item {
  padding: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.item-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.status-badge.available {
  background: #d1fae5;
  color: #059669;
}

.status-badge.paid {
  background: #dbeafe;
  color: #2563eb;
}

.status-badge.active {
  background: #d1fae5;
  color: #059669;
}

.status-badge.completed {
  background: #f3f4f6;
  color: #6b7280;
}

.item-time {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.item-plate {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.item-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  flex: 1;
  padding: 16rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  border: none;
}

.action-btn.cancel {
  background: #fee2e2;
  color: #dc2626;
}

.action-btn.primary {
  background: var(--color-primary);
  color: #fff;
}

.action-btn::after {
  border: none;
}

/* 退出登录 */
.logout-section {
  padding: 24rpx;
}

.logout-btn {
  width: 100%;
  height: 80rpx;
  background: #fff;
  color: var(--color-danger);
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
}

.logout-btn::after {
  border: none;
}
