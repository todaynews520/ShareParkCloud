/* pages/book/index.wxss */
@import "../../styles/theme.wxss";

.book-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 140rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* 信息卡片 */
.info-card {
  margin: 24rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
  border-radius: 24rpx;
  color: #fff;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.spot-number {
  font-size: 48rpx;
  font-weight: 700;
}

.status-badge {
  padding: 6rpx 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  font-size: 24rpx;
}

.spot-location {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 24rpx;
}

.spot-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 28rpx;
}

.price-value {
  font-size: 48rpx;
  font-weight: 700;
  margin: 0 4rpx;
}

.price-unit {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 详情网格 */
.detail-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.detail-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  border-radius: 16rpx;
}

.detail-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.detail-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.detail-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-bottom: 4rpx;
}

.detail-value {
  font-size: 26rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

/* 卡片 */
.card {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 24rpx;
}

/* 车牌输入区域标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 24rpx;
  padding: 0 24rpx;
}

/* 车牌输入 */
.plate-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--color-bg);
  border-radius: 16rpx;
  font-size: 36rpx;
  text-align: center;
  letter-spacing: 4rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.plate-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  background: var(--color-bg);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.plate-history {
  margin-top: 24rpx;
}

.history-title {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.history-tag {
  padding: 8rpx 16rpx;
  background: var(--color-bg);
  border-radius: 24rpx;
  font-size: 26rpx;
  color: var(--color-primary);
}

/* 费用明细 */
.fee-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.fee-row:last-child {
  border-bottom: none;
}

.fee-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.fee-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.fee-row.total {
  padding-top: 20rpx;
  border-top: 2rpx solid var(--color-border);
}

.total-price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-accent);
}

/* 底部按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.footer-price {
  display: flex;
  flex-direction: column;
}

.footer-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.footer-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-accent);
}

.confirm-btn {
  width: 280rpx;
  height: 80rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: none;
}

.confirm-btn::after {
  border: none;
}
