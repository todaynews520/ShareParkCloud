<view class="page-wrapper">

  <!-- 头部区域 -->
  <view class="header-banner">
    <view class="header-inner">
      <view class="header-text">
        <text class="main-title">小区管理</text>
        <text class="sub-title">选择或添加小区</text>
      </view>
      <view class="header-icon">🏢</view>
    </view>
  </view>

  <!-- 当前小区 -->
  <view class="current-section" wx:if="{{currentCommunity}}">
    <view class="section-title">当前小区</view>
    <view class="current-card">
      <view class="current-info">
        <text class="current-name">{{currentCommunity.name}}</text>
        <text class="current-address">{{currentCommunity.address}}</text>
      </view>
      <view class="current-badge">当前</view>
    </view>
  </view>

  <!-- 小区列表 -->
  <view class="list-section">
    <view class="section-header">
      <text class="section-title">小区列表</text>
      <text class="count-badge">{{communityList.length}}</text>
    </view>

    <view wx:if="{{loading}}" class="loading-container">
      <view class="spinner"></view>
      <text>加载中...</text>
    </view>

    <view wx:elif="{{communityList.length === 0}}" class="empty-container">
      <text class="empty-icon">🏢</text>
      <text class="empty-text">暂无小区</text>
    </view>

    <view wx:else class="community-list">
      <view
        wx:for="{{communityList}}"
        wx:key="_id"
        class="community-item"
        bindtap="onSelectCommunity"
        data-id="{{item._id}}"
      >
        <view class="community-info">
          <text class="community-name">{{item.name}}</text>
          <text class="community-address">{{item.address}}</text>
        </view>
        <view class="community-actions">
          <view
            wx:if="{{currentCommunity && currentCommunity._id === item._id}}"
            class="current-tag"
          >
            当前
          </view>
          <view
            class="delete-btn"
            catchtap="onDeleteCommunity"
            data-id="{{item._id}}"
          >
            删除
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 添加小区按钮 -->
  <view class="add-btn-wrapper">
    <button class="add-btn" bindtap="onShowAddModal">
      <text class="add-icon">+</text>
      <text>添加小区</text>
    </button>
  </view>

  <!-- 添加小区弹窗 -->
  <view wx:if="{{showAddModal}}" class="modal-overlay" bindtap="onHideAddModal">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">添加小区</text>
        <view class="modal-close" bindtap="onHideAddModal">✕</view>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">小区名称</text>
          <input
            class="form-input"
            placeholder="请输入小区名称"
            value="{{newCommunityName}}"
            bindinput="onCommunityNameInput"
          />
        </view>
        <view class="form-item">
          <text class="form-label">小区地址</text>
          <input
            class="form-input"
            placeholder="请输入小区地址"
            value="{{newCommunityAddress}}"
            bindinput="onAddressInput"
          />
        </view>
      </view>
      <view class="modal-footer">
        <button class="modal-btn cancel" bindtap="onHideAddModal">取消</button>
        <button class="modal-btn confirm" bindtap="onAddCommunity">确定</button>
      </view>
    </view>
  </view>

  <custom-tab-bar />

</view>
