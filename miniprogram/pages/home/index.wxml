<view class="home-page">
  <!-- 地图视图区域 -->
  <view class="map-hero">
    <map
      id="parkingMap"
      class="parking-map"
      latitude="{{latitude}}"
      longitude="{{longitude}}"
      scale="{{mapScale}}"
      show-location="{{true}}"
      markers="{{mapMarkers}}"
      bindmarkertap="onMarkerTap"
      bindregionchange="onRegionChange"
    >
      <!-- 范围选择器（覆盖在地图上） -->
      <cover-view class="range-selector">
        <cover-view
          wx:for="{{[500, 1000, 3000]}}"
          wx:key="*this"
          wx:for-item="range"
          class="range-btn {{range === selectedRange ? 'active' : ''}}"
          bindtap="onRangeChange"
          data-range="{{range}}"
        >
          {{range < 1000 ? range + 'm' : (range/1000) + 'km'}}
        </cover-view>
      </cover-view>

      <!-- 搜索卡片（覆盖在地图上） -->
      <cover-view class="search-card">
        <cover-view class="search-icon">📍</cover-view>
        <cover-view class="search-text">附近车位</cover-view>
        <cover-view class="search-count">{{parkingList.length}}个可用</cover-view>
      </cover-view>
    </map>
  </view>

  <!-- 筛选标签栏 -->
  <view class="filter-bar">
    <view
      wx:for="{{filterTags}}"
      wx:key="key"
      class="filter-tag {{item.active ? 'active' : ''}}"
      bindtap="onFilterTap"
      data-key="{{item.key}}"
    >
      {{item.label}}
    </view>
  </view>

  <!-- 车位列表 -->
  <view class="parking-list">
    <!-- 加载状态 -->
    <view wx:if="{{loading && parkingList.length === 0}}" class="state-box">
      <view class="loading"></view>
      <text class="state-text">加载中...</text>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{!loading && parkingList.length === 0}}" class="state-box">
      <text class="state-icon">🅿️</text>
      <text class="state-title">暂无可用车位</text>
      <text class="state-desc">成为第一个分享车位的业主吧</text>
    </view>

    <!-- 车位卡片列表 -->
    <view wx:else>
      <view
        wx:for="{{parkingList}}"
        wx:key="_id"
        class="spot-card"
        bindtap="onSpotTap"
        data-id="{{item._id}}"
      >
        <view class="card-header">
          <view class="spot-info">
            <text class="spot-number">{{item.spotNumber || '未知'}}号</text>
          </view>
          <view class="spot-price">
            <text class="price-symbol">¥</text>
            <text class="price-value">{{item.priceHourly || 5}}</text>
            <text class="price-unit">/时</text>
          </view>
        </view>

        <view class="card-body">
          <view class="spot-location">
            <text class="location-icon">📍</text>
            <text class="location-text">{{item.locationName || '未知位置'}}</text>
          </view>

          <view class="spot-time">
            <text class="time-icon">⏰</text>
            <text>{{item.date}} {{item.startTime}}-{{item.endTime}}</text>
          </view>

          <view class="spot-features" wx:if="{{item.features}}">
            <text wx:if="{{item.features.hasCharger}}" class="feature-tag">⚡ 可充电</text>
            <text wx:if="{{item.features.hasMonitor}}" class="feature-tag">📹 有监控</text>
            <text wx:if="{{item.features.isIndoor}}" class="feature-tag">🏢 室内</text>
          </view>
        </view>

        <view class="card-footer">
          <text class="book-hint">点击预约</text>
          <text class="book-arrow">→</text>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{loading && parkingList.length > 0}}" class="load-more">
      <view class="loading"></view>
      <text>加载更多...</text>
    </view>

    <!-- 没有更多 -->
    <view wx:if="{{!hasMore && parkingList.length > 0}}" class="no-more">
      <text>没有更多了</text>
    </view>
  </view>
</view>
