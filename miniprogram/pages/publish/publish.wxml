<view class="page-wrapper">

  <!-- 顶部导航 -->
  <view class="page-header">
    <view class="nav-content">
      <view class="nav-back" bindtap="onBack">
        <text>←</text>
      </view>
      <view class="nav-title">发布车位</view>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <!-- 表单区域 -->
  <view class="form-container">

    <!-- 车位号 -->
    <view class="form-section">
      <view class="section-label">车位号</view>
      <view class="input-card">
        <input
          class="input-field"
          placeholder="请输入车位号（如：A101）"
          value="{{spotNumber}}"
          bindinput="onSpotNumberInput"
        />
      </view>
    </view>

    <!-- 日期和时间 -->
    <view class="form-section">
      <view class="section-label">日期</view>
      <view class="input-card">
        <picker
          mode="date"
          value="{{date}}"
          start="{{today}}"
          bindchange="onDateChange"
          class="picker-card"
        >
          <view class="picker-value">
            {{date || '请选择日期'}}
          </view>
        </picker>
      </view>
    </view>

    <view class="form-section">
      <view class="section-label">开始时间</view>
      <view class="input-card">
        <picker
          mode="time"
          value="{{startTime}}"
          start="{{currentTime}}"
          bindchange="onStartTimeChange"
          class="picker-card"
        >
          <view class="picker-value">
            {{startTime || '请选择开始时间'}}
          </view>
        </picker>
      </view>
    </view>

    <!-- 时长选择 -->
    <view class="form-section">
      <view class="section-label">时长选择</view>
      <view class="duration-card">
        <picker
          mode="selector"
          range="{{durationTexts}}"
          value="{{durationIndex}}"
          bindchange="onDurationChange"
        >
          <view class="picker-value">
            {{durationTexts[durationIndex] || '请选择时长'}}
          </view>
        </picker>
      </view>
      <view class="time-tip">
        <text class="tip-icon">💡</text>
        <text>选择时长自动计算结束时间</text>
      </view>
    </view>

    <!-- 结束时间 -->
    <view class="form-section">
      <view class="section-label">结束时间</view>
      <view class="input-card">
        <picker
          mode="time"
          value="{{endTime}}"
          start="{{currentTime}}"
          bindchange="onEndTimeChange"
          class="picker-card"
        >
          <view class="picker-value {{endTime ? '' : 'placeholder'}}">
            {{endTime || '选择时长后自动计算'}}
          </view>
        </picker>
      </view>
    </view>

  </view>

  <!-- 提交按钮 -->
  <view class="bottom-area">
    <button
      class="submit-btn"
      bindtap="onSubmit"
      disabled="{{submitting}}"
    >
      {{submitting ? '发布中...' : '立即发布'}}
    </button>
  </view>

</view>
