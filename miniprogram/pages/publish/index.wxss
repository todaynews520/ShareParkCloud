/* pages/publish/index.wxss */
@import "../../styles/theme.wxss";

.publish-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 160rpx;
}

/* 头部 */
.header {
  padding: 40rpx 24rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
  color: #fff;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.header-subtitle {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
}

/* 卡片 */
.card {
  margin: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: var(--shadow-sm);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 24rpx;
}

/* 表单项 */
.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

/* 日期选择 */
.date-list {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
}

.date-item {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--color-bg);
  border-radius: 16rpx;
  min-width: 100rpx;
  transition: all 0.2s;
}

.date-item.active {
  background: var(--color-primary);
  color: #fff;
}

.date-weekday {
  font-size: 22rpx;
  margin-bottom: 4rpx;
}

.date-day {
  font-size: 32rpx;
  font-weight: 600;
}

.date-today {
  font-size: 20rpx;
  margin-top: 4rpx;
  opacity: 0.8;
}

/* 时间滑块 */
.time-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.time-slider {
  width: 100%;
  margin: 24rpx 0;
}

.duration-options {
  display: flex;
  gap: 12rpx;
}

.duration-btn {
  padding: 12rpx 24rpx;
  background: var(--color-bg);
  border-radius: 24rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  transition: all 0.2s;
}

.duration-btn.active {
  background: var(--color-primary);
  color: #fff;
}

.time-result {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: var(--color-primary-light);
  border-radius: 16rpx;
}

.result-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.result-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-primary);
}

/* 价格设置 */
.price-suggestions {
  display: flex;
  gap: 12rpx;
}

.suggest-btn {
  padding: 12rpx 24rpx;
  background: var(--color-bg);
  border-radius: 24rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  transition: all 0.2s;
}

.suggest-btn.active {
  background: var(--color-accent);
  color: #fff;
}

.price-input-wrap {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.price-symbol {
  font-size: 32rpx;
  color: var(--color-accent);
}

.price-input {
  width: 100rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-accent);
}

.price-unit {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.earning-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  border-radius: 16rpx;
}

.earning-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.earning-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-accent);
}

.earning-tip {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 特性选择 */
.features-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: var(--color-bg);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.feature-item.active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.feature-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.feature-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.feature-item.active .feature-label {
  color: var(--color-primary);
}

/* 底部按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.footer-info {
  display: flex;
  flex-direction: column;
}

.footer-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.footer-price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-accent);
}

.submit-btn {
  width: 280rpx;
  height: 80rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: none;
}

.submit-btn::after {
  border: none;
}
