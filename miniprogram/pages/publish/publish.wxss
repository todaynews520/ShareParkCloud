/* 全局基础 */
page {
  background: #f7f8fa;
  height: 100vh;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  box-sizing: border-box;
}

.page-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  width: 100%;
  padding-bottom: 180rpx;
}

/* 顶部导航 - 简化 */
.page-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 50rpx 24rpx 32rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.nav-back {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #fff;
  transition: transform 0.2s;
}

.nav-back:active {
  transform: translateX(-4rpx);
}

.nav-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.nav-placeholder {
  width: 48rpx;
}

/* 表单容器 - 优化间距 */
.form-container {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

.form-section {
  margin-bottom: 24rpx;
}

.section-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 12rpx;
  padding-left: 4rpx;
  position: relative;
}

.section-label::before {
  content: '';
  position: absolute;
  left: -8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 2rpx;
}

/* 输入卡片 - 统一样式 */
.input-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 0 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #f0f0f0;
}

.input-field {
  width: 100%;
  height: 88rpx;
  font-size: 28rpx;
  color: #333;
  border: none;
  background: transparent;
  padding: 0;
}

.input-field::placeholder {
  color: #bbb;
}

/* 选择器卡片 - 统一样式 */
.picker-card {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  border: none;
  background: transparent;
  box-sizing: border-box;
}

.picker-card::after {
  border: none;
}

.picker-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  padding-right: 24rpx;
}

.picker-value.placeholder {
  color: #bbb;
}

/* 时长卡片 - 突出显示 */
.duration-card {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.06) 0%, rgba(118, 75, 162, 0.06) 100%);
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid rgba(102, 126, 234, 0.15);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.08);
}

.time-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
}

.tip-icon {
  font-size: 20rpx;
}

/* 底部区域 - 简化 */
.bottom-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.submit-btn[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

.submit-btn:active:not([disabled]) {
  transform: scale(0.97);
}
