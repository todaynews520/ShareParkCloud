/* 全局基础 */
page {
  background: #f7f8fa;
  height: 100vh;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  box-sizing: border-box;
}

.page-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  width: 100%;
  padding-bottom: 140rpx;
}

/* 顶部导航 */
.page-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 50rpx 24rpx 40rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.nav-back {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #fff;
  transition: transform 0.2s;
}

.nav-back:active {
  transform: translateX(-4rpx);
}

.nav-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.nav-placeholder {
  width: 48rpx;
}

/* 表单容器 */
.form-container {
  flex: 1;
  padding: 0 24rpx;
  overflow-y: auto;
}

.form-section {
  margin-bottom: 32rpx;
}

.section-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.section-label::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 3rpx;
}

/* 输入卡片 */
.input-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.input-field {
  width: 100%;
  height: 88rpx;
  font-size: 28rpx;
  color: #333;
  border: none;
  background: transparent;
  padding: 0;
}

.input-field::placeholder {
  color: #ccc;
}

/* 选择器卡片 */
.picker-card {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #eee;
  border-radius: 16rpx;
  background: #fff;
  box-sizing: border-box;
}

.picker-card::after {
  border: none;
}

.picker-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  padding-right: 24rpx;
}

.picker-value.placeholder {
  color: #ccc;
}

/* 时长卡片 */
.duration-card {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.08) 0%, rgba(118, 75, 162, 0.08) 100%);
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid rgba(102, 126, 234, 0.2);
}

.time-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #667eea;
  margin-top: 8rpx;
}

.tip-icon {
  font-size: 20rpx;
}

/* 底部区域 */
.bottom-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.submit-btn[disabled] {
  opacity: 0.6;
}

.submit-btn:active:not([disabled]) {
  transform: scale(0.98);
}
