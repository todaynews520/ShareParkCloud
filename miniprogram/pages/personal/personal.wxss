/* 全局基础 */
page {
  background: #f0fdfa;
  height: 100vh;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  box-sizing: border-box;
}

.page-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  width: 100%;
  padding-bottom: calc(88rpx + env(safe-area-inset-bottom));
}

/* 头部区域 */
.header-banner {
  background: linear-gradient(135deg, #0d9488 0%, #10b981 100%);
  padding: 60rpx 24rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.avatar {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.user-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.username {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.user-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 完善资料按钮 */
.complete-profile-btn {
  width: 100%;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 36rpx;
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.complete-profile-btn::after {
  border: none;
}

.complete-profile-btn:active {
  background: rgba(255, 255, 255, 0.3);
}

/* Tab切换 */
.tab-container {
  background: #fff;
  display: flex;
  margin: 0 24rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  position: relative;
  transition: all 0.2s;
}

.tab-item.active {
  background: linear-gradient(135deg, rgba(13, 148, 136, 0.08) 0%, rgba(16, 185, 129, 0.08) 100%);
  color: #0d9488;
}

.tab-text {
  font-size: 28rpx;
  font-weight: 500;
}

.tab-badge {
  background: #0d9488;
  color: #fff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  font-weight: bold;
}

/* 列表区域 */
.list-section {
  flex: 1;
  overflow-y: auto;
  padding: 0 24rpx 24rpx;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 16rpx;
  color: #999;
}

.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(13, 148, 136, 0.1);
  border-top-color: #0d9488;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 24rpx;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.list-container {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 列表项优化 - 更简洁的卡片 */
.list-item {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, rgba(13, 148, 136, 0.06) 0%, rgba(16, 185, 129, 0.06) 100%);
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
}

.spot-number {
  font-size: 36rpx;
  color: #0d9488;
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* 状态标签 - 更清晰的视觉层次 */
.status-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 18rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.status-tag.available {
  background: #e6f7ff;
  color: #1890ff;
  border: 1rpx solid #91d5ff;
}

.status-tag.reserved {
  background: #f9f0ff;
  color: #722ed1;
  border: 1rpx solid #d3adf7;
}

.status-tag.cancelled {
  background: #f5f5f5;
  color: #999;
  border: 1rpx solid #d9d9d9;
}

.status-tag.confirmed {
  background: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}

.status-tag.pending {
  background: #fffbe6;
  color: #faad14;
  border: 1rpx solid #ffe58f;
}

/* 列表项内容 - 更清晰的布局 */
.item-body {
  padding: 20rpx 24rpx;
}

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}

.item-row:first-child {
  padding-top: 0;
}

.item-row:last-child {
  padding-bottom: 0;
}

.row-label {
  font-size: 26rpx;
  color: #999;
  font-weight: 400;
}

.row-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 列表项底部按钮 - 更简洁 */
.item-footer {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #fafafa;
  border-top: 1rpx solid #f0f0f0;
}

/* 预约记录外层容器 - 使用 gap 控制间距 */
.reservation-item-wrapper {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 卡片外部操作按钮 */
.item-actions {
  display: flex;
  gap: 12rpx;
  padding: 0 4rpx;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  background: #fff;
  border: 1rpx solid #e0e0e0;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  transform: scale(0.97);
}

.action-btn.cancel-btn {
  color: #ff4d4f;
  border-color: #ffccc7;
  background: #fff;
}

.action-btn.cancel-btn:active {
  background: #fff1f0;
}

.action-btn.detail-btn {
  color: #0d9488;
  border-color: #99f6e4;
  background: #fff;
}

.action-btn.detail-btn:active {
  background: #f0fdfa;
}

/* 登录提示 */
.login-prompt {
  padding: 40rpx 24rpx;
  display: flex;
  justify-content: center;
}

.login-btn {
  padding: 24rpx 80rpx;
  background: linear-gradient(135deg, #0d9488 0%, #10b981 100%);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.login-btn::after {
  border: none;
}
