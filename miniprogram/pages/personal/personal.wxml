<view class="page-wrapper">

  <!-- 头部区域 -->
  <view class="header-banner">
    <view class="user-info">
      <view class="avatar">
        <text>👤</text>
      </view>
      <view class="user-details">
        <text class="username">{{userInfo?.nickname || '未登录'}}</text>
        <text class="user-id" wx:if="{{userInfo?.openid}}">{{userInfo.openid.slice(-6)}}</text>
      </view>
    </view>
  </view>

  <!-- Tab切换 -->
  <view class="tab-container">
    <view
      class="tab-item {{currentTab === 'releases' ? 'active' : ''}}"
      bindtap="onTabChange"
      data-value="releases"
    >
      <text class="tab-text">我的发布</text>
      <view class="tab-badge" wx:if="{{myReleases.length > 0}}">{{myReleases.length}}</view>
    </view>
    <view
      class="tab-item {{currentTab === 'reservations' ? 'active' : ''}}"
      bindtap="onTabChange"
      data-value="reservations"
    >
      <text class="tab-text">我的预约</text>
      <view class="tab-badge" wx:if="{{myReservations.length > 0}}">{{myReservations.length}}</view>
    </view>
  </view>

  <!-- 我的发布列表 -->
  <view class="list-section" wx:if="{{currentTab === 'releases'}}">
    <view wx:if="{{loading}}" class="loading-container">
      <view class="spinner"></view>
      <text>加载中...</text>
    </view>

    <view wx:elif="{{myReleases.length === 0}}" class="empty-container">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无发布记录</text>
    </view>

    <view wx:else class="list-container">
      <view
        wx:for="{{myReleases}}"
        wx:key="_id"
        class="list-item"
      >
        <view class="item-header">
          <text class="spot-number">{{item.parking_info?.spot_number || '未知'}}</text>
          <view class="status-tag" :class="item.status === 'available' ? 'available' : 'reserved'">
            <text>{{item.status === 'available' ? '可用' : '已预约'}}</text>
          </view>
        </view>

        <view class="item-body">
          <view class="item-row">
            <text class="row-label">📅 日期</text>
            <text class="row-value">{{item.date}}</text>
          </view>
          <view class="item-row">
            <text class="row-label">⏰ 时段</text>
            <text class="row-value">{{item.start_time}}-{{item.end_time}}</text>
          </view>
          <view class="item-row" wx:if="{{item.duration}}">
            <text class="row-label">⏱️ 时长</text>
            <text class="row-value">{{item.duration}}</text>
          </view>
          <view class="item-row">
            <text class="row-label">📅 创建时间</text>
            <text class="row-value">{{item.create_time}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 我的预约列表 -->
  <view class="list-section" wx:if="{{currentTab === 'reservations'}}">
    <view wx:if="{{loading}}" class="loading-container">
      <view class="spinner"></view>
      <text>加载中...</text>
    </view>

    <view wx:elif="{{myReservations.length === 0}}" class="empty-container">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无预约记录</text>
    </view>

    <view wx:else class="list-container">
      <view
        wx:for="{{myReservations}}"
        wx:key="_id"
        class="list-item"
      >
        <view class="item-header">
          <text class="spot-number">{{item.spot_number}}</text>
          <view class="status-tag" :class="getStatusClass(item.status)">
            <text>{{getStatusText(item.status)}}</text>
          </view>
        </view>

        <view class="item-body">
          <view class="item-row">
            <text class="row-label">📅 日期</text>
            <text class="row-value">{{item.date}}</text>
          </view>
          <view class="item-row">
            <text class="row-label">⏰ 时段</text>
            <text class="row-value">{{item.start_time}}-{{item.end_time}}</text>
          </view>
          <view class="item-row">
            <text class="row-label">🚗 车牌号</text>
            <text class="row-value">{{item.plate_number}}</text>
          </view>
          <view class="item-row">
            <text class="row-label">📅 预约时间</text>
            <text class="row-value">{{item.reserve_time}}</text>
          </view>
        </view>

        <view class="item-footer" wx:if="{{item.status === 'confirmed'}}">
          <button
            class="cancel-btn"
            bindtap="onCancelReservation"
            data-id="{{item._id}}"
          >
            取消预约
          </button>
          <button
            class="detail-btn"
            bindtap="onViewReservation"
            data-id="{{item._id}}"
          >
            查看详情
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- 未登录状态 -->
  <view class="login-prompt" wx:if="{{!isLoggedIn}}">
    <button class="login-btn" bindtap="onGoLogin">
      去登录
    </button>
  </view>

  <custom-tab-bar />

</view>
