<view class="page-wrapper">

  <!-- 头部区域 -->
  <view class="header-banner">
    <view class="user-info">
      <view class="avatar-wrapper">
        <image
          class="avatar"
          src="{{userInfo && userInfo.avatar_url && userInfo.avatar_url.length > 0 ? userInfo.avatar_url : ''}}"
          mode="aspectFill"
          wx:if="{{userInfo && userInfo.avatar_url && userInfo.avatar_url.length > 0}}"
        />
        <view class="avatar-placeholder" wx:else>👤</view>
      </view>
      <view class="user-details">
        <text class="username">{{userInfo && userInfo.nickname ? userInfo.nickname : (isLoggedIn ? '未设置昵称' : '未登录')}}</text>
        <text class="user-tip" wx:if="{{isLoggedIn && (!userInfo || !userInfo.nickname)}}">点击下方按钮完善资料</text>
      </view>
    </view>
    <!-- 完善资料按钮 -->
    <button
      wx:if="{{isLoggedIn && (!userInfo || !userInfo.nickname)}}"
      class="complete-profile-btn"
      bindtap="onCompleteProfile"
    >
      去完善
    </button>
  </view>

  <!-- Tab切换 -->
  <view class="tab-container">
    <view
      class="tab-item {{currentTab === 'releases' ? 'active' : ''}}"
      bindtap="onTabChange"
      data-value="releases"
    >
      <text class="tab-text">我的发布</text>
      <view class="tab-badge" wx:if="{{myReleases.length > 0}}">{{myReleases.length}}</view>
    </view>
    <view
      class="tab-item {{currentTab === 'reservations' ? 'active' : ''}}"
      bindtap="onTabChange"
      data-value="reservations"
    >
      <text class="tab-text">我的预约</text>
      <view class="tab-badge" wx:if="{{myReservations.length > 0}}">{{myReservations.length}}</view>
    </view>
  </view>

  <!-- 我的发布列表 -->
  <view class="list-section" wx:if="{{currentTab === 'releases'}}">
    <view wx:if="{{loading}}" class="loading-container">
      <view class="spinner"></view>
      <text>加载中...</text>
    </view>

    <view wx:elif="{{myReleases.length === 0}}" class="empty-container">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无发布记录</text>
    </view>

    <view wx:else class="list-container">
      <view
        wx:for="{{myReleases}}"
        wx:key="_id"
        class="list-item"
      >
        <view class="item-header">
          <text class="spot-number">{{item.parking_id && item.parking_id.spot_number || '未知'}}</text>
          <view class="status-tag {{item.status === 'available' ? 'available' : 'reserved'}}">
            <text>{{item.status === 'available' ? '可用' : '已预约'}}</text>
          </view>
        </view>

        <view class="item-body">
          <view class="item-row">
            <text class="row-label">📅 日期</text>
            <text class="row-value">{{item.date}}</text>
          </view>
          <view class="item-row">
            <text class="row-label">⏰ 时段</text>
            <text class="row-value">{{item.start_time}}-{{item.end_time}}</text>
          </view>
          <view class="item-row" wx:if="{{item.duration}}">
            <text class="row-label">⏱️ 时长</text>
            <text class="row-value">{{item.duration}}</text>
          </view>
          <view class="item-row">
            <text class="row-label">📅 创建时间</text>
            <text class="row-value">{{formatTimestamp(item.create_time)}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 我的预约列表 -->
  <view class="list-section" wx:if="{{currentTab === 'reservations'}}">
    <view wx:if="{{loading}}" class="loading-container">
      <view class="spinner"></view>
      <text>加载中...</text>
    </view>

    <view wx:elif="{{myReservations.length === 0}}" class="empty-container">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无预约记录</text>
    </view>

    <view wx:else class="list-container">
      <view
        wx:for="{{myReservations}}"
        wx:key="_id"
        class="reservation-item-wrapper"
      >
        <view class="list-item">
          <view class="item-header">
            <text class="spot-number">{{item.spot_number}}</text>
            <view class="status-tag {{getStatusClass(item.status)}}">
              <text>{{getStatusText(item.status)}}</text>
            </view>
          </view>

          <view class="item-body">
            <view class="item-row">
              <text class="row-label">📅 日期</text>
              <text class="row-value">{{item.date}}</text>
            </view>
            <view class="item-row">
              <text class="row-label">⏰ 时段</text>
              <text class="row-value">{{item.start_time}}-{{item.end_time}}</text>
            </view>
            <view class="item-row">
              <text class="row-label">🚗 车牌号</text>
              <text class="row-value">{{item.plate_number}}</text>
            </view>
            <view class="item-row">
              <text class="row-label">📅 预约时间</text>
              <text class="row-value">{{formatTimestamp(item.reserve_time)}}</text>
            </view>
          </view>
        </view>

        <!-- 操作按钮 - 卡片外部 -->
        <view class="item-actions" wx:if="{{item.status === 'confirmed'}}">
          <button
            class="action-btn cancel-btn"
            bindtap="onCancelReservation"
            data-id="{{item._id}}"
          >
            取消预约
          </button>
          <button
            class="action-btn detail-btn"
            bindtap="onViewReservation"
            data-id="{{item._id}}"
          >
            查看详情
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- 未登录状态 -->
  <view class="login-prompt" wx:if="{{!isLoggedIn}}">
    <button class="login-btn" bindtap="onGoLogin">
      去登录
    </button>
  </view>

  <custom-tab-bar />

</view>
