<view class="page-wrapper" wx:if="{{releaseInfo}}">

  <!-- 顶部导航 -->
  <view class="page-header">
    <view class="nav-content">
      <view class="nav-back" bindtap="onBack">
        <text>←</text>
      </view>
      <view class="nav-title">预约车位</view>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <!-- 车位信息卡片 -->
  <view class="info-card">
    <view class="card-header">
      <view class="spot-number">{{releaseInfo.parking_info?.spot_number || '未知'}}</view>
      <view class="status-tag available">
        <text class="status-dot"></text>
        <text>可用</text>
      </view>
    </view>

    <view class="card-body">
      <view class="info-row">
        <view class="info-item">
          <text class="label">📅 日期</text>
          <text class="value">{{releaseInfo.date}}</text>
        </view>
        <view class="info-item">
          <text class="label">⏰ 时段</text>
          <text class="value">{{releaseInfo.start_time}}-{{releaseInfo.end_time}}</text>
        </view>
      </view>

      <view class="info-row" wx:if="{{releaseInfo.duration}}">
        <view class="info-item">
          <text class="label">⏱️ 时长</text>
          <text class="value">{{releaseInfo.duration}}</text>
        </view>
        <view class="info-item">
          <text class="label">👤 发布者</text>
          <text class="value">{{releaseInfo.owner_info?.nickname || '业主'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 预约表单 -->
  <view class="form-container">

    <!-- 用户角色 -->
    <view class="form-section">
      <view class="section-label">您的角色</view>
      <view class="role-selector">
        <view
          class="role-item {{role === 'owner' ? 'active' : ''}}"
          bindtap="onRoleChange"
          data-value="owner"
        >
          <text class="role-icon">👤</text>
          <text class="role-text">业主</text>
        </view>
        <view
          class="role-item {{role === 'property' ? 'active' : ''}}"
          bindtap="onRoleChange"
          data-value="property"
        >
          <text class="role-icon">🏢</text>
          <text class="role-text">物业</text>
        </view>
      </view>
    </view>

    <!-- 车牌号 -->
    <view class="form-section">
      <view class="section-label">车牌号</view>
      <view class="input-card">
        <input
          class="input-field"
          placeholder="请输入车牌号"
          value="{{plateNumber}}"
          bindinput="onPlateInput"
          maxlength="10"
        />
      </view>
      <view class="input-hint" wx:if="{{role === 'owner'}}">
        <text class="hint-icon">ℹ️</text>
        <text>请填写您的车牌号以便物业放行</text>
      </view>
    </view>

  </view>

  <!-- 提交按钮 -->
  <view class="bottom-area">
    <button
      class="submit-btn"
      bindtap="onSubmit"
      disabled="{{submitting}}"
    >
      {{submitting ? '预约中...' : '立即预约'}}
    </button>
  </view>

</view>

<!-- 空状态 -->
<view wx:else class="empty-page">
  <view class="empty-icon">⚠️</view>
  <text class="empty-text">车位信息加载失败</text>
  <button class="retry-btn" bindtap="onRetry">重新加载</button>
</view>
