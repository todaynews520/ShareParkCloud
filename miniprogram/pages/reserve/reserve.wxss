/* 全局基础 */
page {
  background: #f7f8fa;
  height: 100vh;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  box-sizing: border-box;
}

.page-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  width: 100%;
  padding-bottom: 140rpx;
}

/* 顶部导航 */
.page-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 50rpx 24rpx 40rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.nav-back {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #fff;
}

.nav-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.nav-placeholder {
  width: 48rpx;
}

/* 车位信息卡片 */
.info-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 16rpx 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  background: linear-gradient(135deg, rgba(102,126,234,0.08) 0%, rgba(118,75,162,0.08) 100%);
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.spot-number {
  font-size: 40rpx;
  color: #667eea;
  font-weight: 700;
}

.status-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.status-tag.available {
  background: #d4edda;
  color: #155724;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  background: #52c41a;
  border-radius: 50%;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.card-body {
  padding: 24rpx;
  border-top: 1rpx solid #f5f5f5;
}

.info-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.label {
  font-size: 24rpx;
  color: #999;
}

.value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 预约表单 */
.form-container {
  flex: 1;
  padding: 0 24rpx;
  overflow-y: auto;
}

.form-section {
  margin-bottom: 32rpx;
}

.section-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.section-label::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 3rpx;
}

/* 角色选择器 */
.role-selector {
  display: flex;
  gap: 16rpx;
}

.role-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 16rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid #eee;
  transition: all 0.2s;
}

.role-item.active {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.08) 0%, rgba(118, 75, 162, 0.08) 100%);
  border-color: #667eea;
}

.role-icon {
  font-size: 48rpx;
}

.role-text {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.role-item.active .role-text {
  color: #667eea;
  font-weight: 600;
}

/* 输入卡片 */
.input-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  height: 88rpx;
  display: flex;
  align-items: center;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  border: none;
  background: transparent;
  padding: 0;
}

.input-field::placeholder {
  color: #ccc;
}

.input-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #667eea;
  margin-top: 8rpx;
  line-height: 1.5;
}

.hint-icon {
  font-size: 20rpx;
}

/* 底部区域 */
.bottom-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.submit-btn[disabled] {
  opacity: 0.6;
}

.submit-btn:active:not([disabled]) {
  transform: scale(0.98);
}

/* 空状态 */
.empty-page {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.retry-btn {
  padding: 22rpx 56rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}
