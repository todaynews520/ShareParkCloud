/* 全局基础 */
page {
  background: #f0fdfa;
  height: 100vh;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  box-sizing: border-box;
}

.page-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  width: 100%;
  padding-bottom: 180rpx;
}

/* 顶部导航 - 简化 */
.page-header {
  background: linear-gradient(135deg, #0d9488 0%, #10b981 100%);
  padding: 50rpx 24rpx 32rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.nav-back {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #fff;
  transition: transform 0.2s;
}

.nav-back:active {
  transform: translateX(-4rpx);
}

.nav-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.nav-placeholder {
  width: 48rpx;
}

/* 车位信息卡片 - 优化 */
.info-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  background: linear-gradient(135deg, rgba(13, 148, 136, 0.06) 0%, rgba(16, 185, 129, 0.06) 100%);
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
}

.spot-number {
  font-size: 36rpx;
  color: #0d9488;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 18rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-tag.available {
  background: #e6f7ff;
  color: #1890ff;
  border: 1rpx solid #91d5ff;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  background: #1890ff;
  border-radius: 50%;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.card-body {
  padding: 20rpx 24rpx;
}

.info-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.label {
  font-size: 22rpx;
  color: #999;
}

.value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 预约表单 - 简化 */
.form-container {
  flex: 1;
  padding: 0 24rpx;
  overflow-y: auto;
}

.form-section {
  margin-bottom: 24rpx;
}

.section-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 12rpx;
  padding-left: 4rpx;
  position: relative;
}

.section-label::before {
  content: '';
  position: absolute;
  left: -8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 24rpx;
  background: linear-gradient(135deg, #0d9488 0%, #10b981 100%);
  border-radius: 2rpx;
}

/* 输入卡片 - 统一样式 */
.input-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 0 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #f0f0f0;
  height: 88rpx;
  display: flex;
  align-items: center;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  border: none;
  background: transparent;
  padding: 0;
}

.input-field::placeholder {
  color: #bbb;
}

.input-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
  line-height: 1.5;
}

.hint-icon {
  font-size: 20rpx;
}

/* 订阅消息提示 - 简化 */
.subscribe-tip {
  background: linear-gradient(135deg, rgba(13, 148, 136, 0.05) 0%, rgba(16, 185, 129, 0.05) 100%);
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  border: 1rpx solid rgba(13, 148, 136, 0.1);
}

.tip-icon {
  font-size: 28rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #0d9488;
  text-align: center;
}

.subscribe-btn {
  width: 100%;
  height: 68rpx;
  background: linear-gradient(135deg, #0d9488 0%, #10b981 100%);
  color: #fff;
  border: none;
  border-radius: 34rpx;
  font-size: 26rpx;
  font-weight: 600;
  padding: 0;
}

.subscribe-btn::after {
  border: none;
}

/* 底部区域 - 简化 */
.bottom-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  background: linear-gradient(135deg, #0d9488 0%, #10b981 100%);
  color: #fff;
  border: none;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 6rpx 20rpx rgba(13, 148, 136, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.submit-btn[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

.submit-btn:active:not([disabled]) {
  transform: scale(0.97);
}

/* 空状态 */
.empty-page {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.retry-btn {
  padding: 22rpx 56rpx;
  background: linear-gradient(135deg, #0d9488 0%, #10b981 100%);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* ========== 预约成功动画 ========== */
/* 成功模态框 */
.success-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  backdrop-filter: blur(4px);
}

.success-modal-content {
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx;
  text-align: center;
  width: 85%;
  max-width: 600rpx;
  animation: successModalIn 0.3s ease;
}

@keyframes successModalIn {
  from {
    transform: scale(0.95);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

/* 成功对勾动画 */
.success-checkmark {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: block;
  margin: 0 auto 32rpx;
  position: relative;
}

.checkmark-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  position: absolute;
  top: 0;
  left: 0;
  border: 4rpx solid #10b981;
  animation: checkmarkCircle 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
}

@keyframes checkmarkCircle {
  0% {
    stroke-dashoffset: 166;
  }
  100% {
    stroke-dashoffset: 0;
  }
}

.checkmark-check {
  width: 60rpx;
  height: 100rpx;
  border: 6rpx solid #fff;
  border-top: none;
  border-left: none;
  transform: rotate(45deg);
  position: absolute;
  top: 20rpx;
  left: 46rpx;
  opacity: 0;
  animation: checkmarkCheck 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.5s forwards;
}

@keyframes checkmarkCheck {
  0% {
    height: 0;
    opacity: 1;
  }
  100% {
    height: 100rpx;
    opacity: 1;
  }
}

.success-bg {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
  animation: successBg 0.4s ease-in-out 0.4s forwards, successScale 0.3s ease-in-out 0.9s both;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.4);
}

@keyframes successBg {
  to {
    box-shadow: inset 0 0 0 50rpx #10b981;
  }
}

@keyframes successScale {
  0%, 100% {
    transform: none;
  }
  50% {
    transform: scale(1.1);
  }
}

.success-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 16rpx;
}

.success-desc {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

.success-info {
  background: #f0fdfa;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  text-align: left;
}

.success-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.success-info-row:last-child {
  margin-bottom: 0;
}

.success-info-label {
  color: #6b7280;
}

.success-info-value {
  font-weight: bold;
  color: #1f2937;
}

.success-info-value.price {
  color: #f97316;
}

.success-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #0d9488 0%, #10b981 100%);
  color: #fff;
  border: none;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(13, 148, 136, 0.3);
}

.success-btn::after {
  border: none;
}

.success-btn.secondary {
  background: transparent;
  color: #6b7280;
  box-shadow: none;
  font-size: 28rpx;
}
