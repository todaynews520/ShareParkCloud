/* app.wxss - 全局样式 */

/* 主题色变量 - Teal色系 */
page {
  --color-primary: #0d9488;
  --color-primary-light: #14b8a6;
  --color-primary-dark: #0f766e;
  --color-secondary: #10b981;
  --color-accent: #f97316;
  --color-success: #22c55e;
  --color-warning: #f59e0b;
  --color-error: #ef4444;
  --color-info: #3b82f6;
  --color-bg: #f0fdfa;
  --color-bg-light: #ccfbf1;
  --color-text-primary: #1f2937;
  --color-text-secondary: #6b7280;
  --color-text-tertiary: #9ca3af;
  --color-border: #e5e7eb;
  --shadow-sm: 0 1px 2px 0 rgba(13, 148, 136, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(13, 148, 136, 0.1);
  --shadow-lg: 0 10px 15px -3px rgba(13, 148, 136, 0.1);
  --shadow-xl: 0 20px 25px -5px rgba(13, 148, 136, 0.1);

  background-color: #f0fdfa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 14px;
  line-height: 1.6;
  color: #1f2937;
}

/* 通用样式 */
.container {
  padding: 20rpx;
}

.card {
  background: #fff;
  border-radius: 8px;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.btn {
  background: linear-gradient(135deg, #0d9488 0%, #10b981 100%);
  color: #fff;
  border: none;
  border-radius: 12px;
  padding: 20rpx 40rpx;
  font-size: 16px;
  display: block;
  width: 100%;
  text-align: center;
  box-shadow: 0 4px 12px rgba(13, 148, 136, 0.3);
}

.btn:active {
  transform: scale(0.98);
}

/* 输入框样式 */
.input-group {
  margin-bottom: 20rpx;
}

.input-label {
  display: block;
  margin-bottom: 8rpx;
  color: #666;
}

.input-field {
  width: 100%;
  padding: 12rpx 16rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8px;
  font-size: 14px;
  box-sizing: border-box;
}

.input-field:focus {
  border-color: #0d9488;
  outline: none;
  box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.1);
}

/* 选择器样式 */
.picker {
  width: 100%;
  height: 40px;
  line-height: 40px;
  background: #fff;
  border: 1rpx solid #e0e0e0;
  border-radius: 8px;
  padding: 0 16rpx;
  box-sizing: border-box;
}

/* 列表项样式 */
.list-item {
  background: #fff;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-radius: 8px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.list-item-title {
  font-weight: 600;
  margin-bottom: 4rpx;
}

.list-item-subtitle {
  font-size: 12px;
  color: #999;
}

/* 状态标签 */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 12px;
  font-size: 12px;
}

.tag-success {
  background: #d1fae5;
  color: #059669;
}

.tag-warning {
  background: #fef3c7;
  color: #d97706;
}

.tag-error {
  background: #fee2e2;
  color: #dc2626;
}

.tag-primary {
  background: #ccfbf1;
  color: #0d9488;
}

.tag-info {
  background: #dbeafe;
  color: #2563eb;
}

/* 加载动画 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(13, 148, 136, 0.1);
  border-top-color: #0d9488;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 提示框 */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.8);
  color: #fff;
  padding: 20rpx 40rpx;
  border-radius: 8px;
  z-index: 9999;
}

/* 隐藏元素 */
.hidden {
  display: none !important;
}
