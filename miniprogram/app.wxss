/* app.wxss - 全局样式 */

/* 基础重置 */
page {
  background-color: #f7f8fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 14px;
  line-height: 1.6;
  color: #333;
}

/* 通用样式 */
.container {
  padding: 20rpx;
}

.card {
  background: #fff;
  border-radius: 8px;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 20rpx 40rpx;
  font-size: 16px;
  display: block;
  width: 100%;
  text-align: center;
}

.btn:active {
  opacity: 0.8;
}

/* 输入框样式 */
.input-group {
  margin-bottom: 20rpx;
}

.input-label {
  display: block;
  margin-bottom: 8rpx;
  color: #666;
}

.input-field {
  width: 100%;
  padding: 12rpx 16rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8px;
  font-size: 14px;
  box-sizing: border-box;
}

.input-field:focus {
  border-color: #667eea;
  outline: none;
}

/* 选择器样式 */
.picker {
  width: 100%;
  height: 40px;
  line-height: 40px;
  background: #fff;
  border: 1rpx solid #e0e0e0;
  border-radius: 8px;
  padding: 0 16rpx;
  box-sizing: border-box;
}

/* 列表项样式 */
.list-item {
  background: #fff;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-radius: 8px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.list-item-title {
  font-weight: 600;
  margin-bottom: 4rpx;
}

.list-item-subtitle {
  font-size: 12px;
  color: #999;
}

/* 状态标签 */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 4px;
  font-size: 12px;
}

.tag-success {
  background: #e6f7ff;
  color: #1890ff;
}

.tag-warning {
  background: #fff7e6;
  color: #fa8c16;
}

.tag-error {
  background: #fff2f0;
  color: #f5222d;
}

/* 加载动画 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(102, 126, 234, 0.1);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 提示框 */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.8);
  color: #fff;
  padding: 20rpx 40rpx;
  border-radius: 8px;
  z-index: 9999;
}

/* 隐藏元素 */
.hidden {
  display: none !important;
}
