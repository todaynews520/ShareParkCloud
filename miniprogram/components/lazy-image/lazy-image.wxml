<!-- components/lazy-image/lazy-image.wxml -->
<view class="lazy-image-container" style="width: {{width}}; height: {{height}}; border-radius: {{radius}};">
  <!-- 占位符 -->
  <view wx:if="{{!showImage && !error}}" class="lazy-placeholder">
    <view class="loading-spinner"></view>
  </view>

  <!-- 错误状态 -->
  <view wx:if="{{error}}" class="lazy-error">
    <text class="error-icon">🖼️</text>
  </view>

  <!-- 实际图片 -->
  <image
    wx:if="{{showImage && !error}}"
    class="lazy-image {{loaded ? 'loaded' : ''}}"
    src="{{src}}"
    mode="{{mode}}"
    style="width: 100%; height: 100%; border-radius: {{radius}};"
    binderror="onImageError"
    lazy-load
  />
</view>
