/* components/plate-input/index.wxss */

@import "../../styles/theme.wxss";

.plate-input-container {
  width: 100%;
  padding: 24rpx 0;
}

/* 车牌输入区域 */
.plate-section {
  width: 100%;
}

.section-title {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
  font-weight: 500;
}

/* 分段输入框 */
.plate-boxes {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
}

.plate-box {
  flex-shrink: 0;
  width: 64rpx;
  height: 76rpx;
  background: #ffffff;
  border: 3rpx solid #d1d5db;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  position: relative;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.plate-box.active {
  border-color: #0d9488;
  border-width: 4rpx;
  box-shadow: 0 0 0 4rpx rgba(13, 148, 136, 0.2), 0 4rpx 8rpx rgba(0, 0, 0, 0.15);
  transform: scale(1.05);
}

.plate-box.filled {
  background: #ccfbf1;
  border-color: #0d9488;
  border-width: 3rpx;
}

.plate-box.filled .box-text {
  color: #0f766e;
  font-weight: 700;
}

.plate-box.disabled {
  opacity: 0.4;
  background: #f3f4f6;
  border-color: #e5e7eb;
  border-style: solid;
}

.plate-box.enabled {
  border-style: dashed;
  border-color: #0d9488;
  background: #f0fdfa;
}

.box-text {
  font-size: 28rpx;
  color: #9ca3af;
  font-weight: 600;
}

/* 间隔点 */
.plate-dot {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  background: #6b7280;
  border-radius: 50%;
  margin: 0 6rpx;
}

/* 新能源切换按钮 */
.plate-toggle {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding: 0 8rpx;
}

.toggle-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #ffffff;
  border: 3rpx solid #d1d5db;
  border-radius: var(--radius-full);
  transition: all 0.3s;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.08);
}

.toggle-btn.active {
  background: #0d9488;
  border-color: #0f766e;
  box-shadow: 0 4rpx 8rpx rgba(13, 148, 136, 0.3);
}

.toggle-icon {
  font-size: 28rpx;
}

.toggle-text {
  font-size: 26rpx;
  color: #4b5563;
  font-weight: 500;
}

.toggle-btn.active .toggle-text {
  color: #ffffff;
  font-weight: 600;
}

.toggle-btn.active .toggle-icon {
  filter: brightness(0) invert(1);
}

/* 历史车牌 */
.plate-history {
  margin-top: 24rpx;
  padding: 0 8rpx;
}

.history-title {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.history-scroll {
  width: 100%;
  white-space: nowrap;
}

.history-list {
  display: inline-flex;
  gap: 12rpx;
}

.history-tag {
  display: inline-flex;
  padding: 10rpx 18rpx;
  background: #ffffff;
  border: 2rpx solid #0d9488;
  border-radius: var(--radius-full);
  font-size: 26rpx;
  color: #0f766e;
  font-weight: 600;
  white-space: nowrap;
  box-shadow: 0 2rpx 4rpx rgba(13, 148, 136, 0.15);
}

/* 自定义键盘 */
.keyboard-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #e5e7eb;
  border-top: 4rpx solid #d1d5db;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 1000;
  animation: slideUp 0.3s ease-out;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.1);
}

/* 键盘标题栏 */
.keyboard-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #d1d5db;
  border-bottom: 2rpx solid #9ca3af;
}

.keyboard-title {
  font-size: 28rpx;
  color: #374151;
  font-weight: 600;
}

.keyboard-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 2rpx solid #9ca3af;
  border-radius: 50%;
  transition: all 0.2s;
}

.keyboard-close:active {
  background: #e5e7eb;
  transform: scale(0.9);
}

.close-icon {
  font-size: 32rpx;
  color: #6b7280;
  font-weight: 300;
  line-height: 1;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.keyboard {
  padding: 16rpx 12rpx 24rpx;
}

.keyboard-row {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.key-btn {
  min-width: 64rpx;
  height: 92rpx;
  background: #ffffff;
  border: 2rpx solid #9ca3af;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #1f2937;
  font-weight: 600;
  transition: all 0.1s;
  flex: 1;
  max-width: 72rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.key-btn:active {
  background: #0d9488;
  border-color: #0f766e;
  color: #ffffff;
  transform: scale(0.95);
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.15);
}

.key-btn.disabled {
  opacity: 0.25;
  background: #f3f4f6;
  border-color: #e5e7eb;
  color: #9ca3af;
  pointer-events: none;
  box-shadow: none;
}

/* 省份键盘特殊样式 */
.province-keyboard .key-btn {
  font-size: 30rpx;
}

.province-keyboard .keyboard-row {
  justify-content: center;
}

.province-keyboard .key-btn {
  max-width: 64rpx;
  min-width: 64rpx;
}

/* 删除键 */
.key-btn-delete {
  background: #fee2e2;
  border-color: #f87171;
  min-width: 88rpx;
  max-width: 120rpx;
  flex: 0 0 100rpx;
  color: #dc2626;
}

.key-btn-delete:active {
  background: #dc2626;
  border-color: #b91c1c;
  color: #ffffff;
}

.delete-icon {
  font-size: 36rpx;
}

/* 字母数字键盘特殊布局 */
.alphanumeric-keyboard .keyboard-row:first-child {
  justify-content: space-between;
}

.alphanumeric-keyboard .keyboard-row:first-child .key-btn {
  flex: 1;
  max-width: none;
}

.alphanumeric-keyboard .keyboard-row:not(:first-child) {
  justify-content: center;
}

.alphanumeric-keyboard .keyboard-row:not(:first-child) .key-btn {
  flex: 1;
  max-width: 72rpx;
}

/* 字母键盘（第2位专用） */
.letter-keyboard .keyboard-row {
  justify-content: center;
}

.letter-keyboard .key-btn {
  flex: 1;
  max-width: 72rpx;
}

/* 新能源专用键盘 */
.new-energy-keyboard {
  padding: 40rpx 24rpx;
}

.new-energy-keyboard .keyboard-row {
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.key-btn-large {
  min-width: 200rpx !important;
  max-width: 280rpx !important;
  height: 100rpx !important;
  font-size: 40rpx !important;
  flex: 0 0 280rpx !important;
  background: #ccfbf1;
  border-color: #0d9488;
  border-width: 3rpx;
  color: #0f766e;
}

.key-btn-large:active {
  background: #0d9488;
  border-color: #0f766e;
  color: #ffffff;
}

/* 键盘背景遮罩 */
.keyboard-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 999;
}
