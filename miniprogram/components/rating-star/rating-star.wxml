<!-- components/rating-star/rating-star.wxml -->
<view class="rating-star size-{{size}} {{readonly ? 'readonly' : ''}}">
  <view
    wx:for="{{stars}}"
    wx:key="index"
    class="star-item {{item}}"
    data-index="{{index}}"
    bindtap="onStarTap"
  >
    <text class="star-icon">{{item === 'full' ? '⭐' : (item === 'half' ? '⭐' : '☆')}}</text>
  </view>
  <view wx:if="{{currentValue > 0}}" class="rating-value">{{currentValue}}</view>
</view>
