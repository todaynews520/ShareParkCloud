/* styles/tailwind.wxss - Tailwind CSS 基础类 */

/* 布局 */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-row { flex-direction: row; }
.flex-1 { flex: 1; }
.items-center { align-items: center; }
.items-start { align-items: flex-start; }
.items-end { align-items: flex-end; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.justify-around { justify-content: space-around; }
.gap-1 { gap: 8rpx; }
.gap-2 { gap: 12rpx; }
.gap-3 { gap: 16rpx; }
.gap-4 { gap: 24rpx; }

/* 定位 */
.relative { position: relative; }
.absolute { position: absolute; }
.fixed { position: fixed; }
.inset-0 { top: 0; right: 0; bottom: 0; left: 0; }

/* 尺寸 */
.w-full { width: 100%; }
.h-full { height: 100%; }
.min-h-screen { min-height: 100vh; }

/* 间距 */
.p-2 { padding: 16rpx; }
.p-3 { padding: 24rpx; }
.p-4 { padding: 32rpx; }
.px-2 { padding-left: 16rpx; padding-right: 16rpx; }
.py-2 { padding-top: 16rpx; padding-bottom: 16rpx; }
.px-3 { padding-left: 24rpx; padding-right: 24rpx; }
.py-3 { padding-top: 24rpx; padding-bottom: 24rpx; }
.m-2 { margin: 16rpx; }
.mx-2 { margin-left: 16rpx; margin-right: 16rpx; }
.my-2 { margin-top: 16rpx; margin-bottom: 16rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mt-2 { margin-top: 16rpx; }
.mt-3 { margin-top: 24rpx; }

/* 文本 */
.text-xs { font-size: 20rpx; }
.text-sm { font-size: 24rpx; }
.text-base { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-2xl { font-size: 48rpx; }
.text-center { text-align: center; }
.font-bold { font-weight: 700; }
.font-medium { font-weight: 500; }
.truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 颜色 */
.text-primary { color: var(--color-primary); }
.text-secondary { color: var(--color-text-secondary); }
.text-accent { color: var(--color-accent); }
.text-danger { color: var(--color-danger); }
.text-white { color: #ffffff; }
.bg-primary { background-color: var(--color-primary); }
.bg-white { background-color: #ffffff; }
.bg-card { background-color: var(--color-card); }

/* 圆角 */
.rounded { border-radius: var(--radius-md); }
.rounded-lg { border-radius: var(--radius-lg); }
.rounded-xl { border-radius: var(--radius-xl); }
.rounded-full { border-radius: var(--radius-full); }

/* 阴影 */
.shadow-sm { box-shadow: var(--shadow-sm); }
.shadow-md { box-shadow: var(--shadow-md); }
.shadow-lg { box-shadow: var(--shadow-lg); }

/* 其他 */
.overflow-hidden { overflow: hidden; }
.overflow-x-auto { overflow-x: auto; }
.pointer-events-none { pointer-events: none; }
.cursor-pointer { cursor: pointer; }
.opacity-50 { opacity: 0.5; }
.opacity-100 { opacity: 1; }
.transition { transition: all 0.3s ease; }
