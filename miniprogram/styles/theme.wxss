/* styles/theme.wxss - 主题变量（Teal色系） */

page {
  /* 颜色体系 */
  --color-primary: #0d9488;
  --color-primary-light: #f0fdfa;
  --color-primary-dark: #0f766e;
  --color-secondary: #10b981;
  --color-accent: #f97316;
  --color-danger: #ef4444;
  --color-warning: #f59e0b;
  --color-success: #22c55e;
  --color-info: #3b82f6;
  --color-bg: #f0fdfa;
  --color-bg-light: #ccfbf1;
  --color-card: #ffffff;
  --color-text-primary: #1f2937;
  --color-text-secondary: #6b7280;
  --color-text-tertiary: #9ca3af;
  --color-border: #e5e7eb;

  /* 字体 */
  --font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;
  --radius-full: 9999rpx;

  /* 阴影 */
  --shadow-sm: 0 1px 2px 0 rgba(13, 148, 136, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(13, 148, 136, 0.1);
  --shadow-lg: 0 10px 15px -3px rgba(13, 148, 136, 0.1);
  --shadow-xl: 0 20px 25px -5px rgba(13, 148, 136, 0.1);

  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 12rpx;
  --spacing-md: 16rpx;
  --spacing-lg: 24rpx;
  --spacing-xl: 32rpx;
  --spacing-2xl: 48rpx;

  /* 页面基础 */
  background-color: var(--color-bg);
  font-family: var(--font-family);
  color: var(--color-text-primary);
  line-height: 1.6;
}
